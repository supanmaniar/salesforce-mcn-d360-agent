# Salesforce MCN + D360 Agent — environment configuration
#
# Copy to .env and fill in, or export these in your shell.
# Nothing here is required for the mc-next or data360-connect API families —
# they run entirely off the Salesforce CLI session.

# ---------------------------------------------------------------------------
# Target org (recommended)
# ---------------------------------------------------------------------------
# The alias or username you used with `sf org login web --alias <alias>`.
# If unset, the scripts fall back to `sf config get target-org`.
SF_TARGET_ORG=my-org

# ---------------------------------------------------------------------------
# API version (optional)
# ---------------------------------------------------------------------------
# Defaults to 66.0. Override to pin a specific version.
# SF_API_VERSION=66.0

# ---------------------------------------------------------------------------
# Data 360 tenant host (required only for the `data360` API family)
# ---------------------------------------------------------------------------
# The `data360` family (/api/v1, /api/v2) is served from the Data 360 tenant
# host, not the org instance. The `mc-next` and `data360-connect` families do
# NOT need this.
#
# Find yours in Data 360 Setup, or from the URL you use to open Data 360.
# Do not guess a hostname — an incorrect value fails with a 404.
# DATA360_TENANT_URL=https://my-tenant.c360a.salesforce.com
